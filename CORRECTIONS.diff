+
+/* ==========================================================================================
+   MISSION 15 — §8.2 « l'écriture disparaît au survol »
+   Règle de sécurité appliquée à toute l'application : un élément survolé garde un texte
+   contrasté. On n'impose pas de couleur unique (chaque fond garde son identité) mais on
+   interdit les états où le texte devient transparent, quasi invisible ou de la couleur du fond.
+   ========================================================================================== */
+.nav-item:hover, .nav-link:hover, .sidebar a:hover, .sidebar button:hover,
+[data-view]:hover, [data-rubric]:hover, [data-sub-tab]:hover, .button:hover, .tile:hover {
+  opacity: 1;
+}
+.nav-item:hover:not(.is-active), .nav-link:hover:not(.active) { color: #1A1A1A; }
+/* Les en-têtes de colonnes étaient en gris très clair sur les cartes de statistiques (2,36:1). */
+.data-table thead th, .data-table th, table.data-table thead th { color: #4A4A4A; }
+.scan-data-table thead th, .scan-table-card thead th { color: #4A4A4A; font-weight: 700; }
+.nav-item:focus-visible, .nav-link:focus-visible, .button:focus-visible,
+[data-view]:focus-visible, [data-rubric]:focus-visible {
+  outline: 2px solid #111111;
+  outline-offset: 2px;
+}
+/* Le survol ne doit jamais changer la couleur du texte vers une teinte plus claire que le fond. */
+.nav-item:hover svg, .nav-link:hover svg { color: currentColor; }
+:root { --muted-strong: #5A5A5A; }
+.hint, .muted, small.muted, .stat-foot, .recent-empty, .sidebar-tip > span { color: var(--muted-strong); }
